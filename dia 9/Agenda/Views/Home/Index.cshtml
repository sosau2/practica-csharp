@{
    ViewData["Title"] = "CRM Dashboard";
}

<div class="container py-4">  
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <p class="text-uppercase text-muted mb-1">Resumen</p>
            <h1 class="h3 mb-0">Dashboard CRM</h1>
        </div>
        <button class="btn btn-primary rounded-pill px-3">+ Nuevo cliente</button>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted small mb-2">Clientes</p>
                    <h2 class="mb-0">1,248</h2>
                    <small class="text-success">+12% este mes</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted small mb-2">Ventas</p>
                    <h2 class="mb-0">$48.6K</h2>
                    <small class="text-success">+8.4% este mes</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted small mb-2">Seguimientos</p>
                    <h2 class="mb-0">86</h2>
                    <small class="text-warning">12 pendientes</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted small mb-2">Tasa de cierre</p>
                    <h2 class="mb-0">68%</h2>
                    <small class="text-success">+3.1% esta semana</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center py-3">
                    <h3 class="h5 mb-0">Clientes recientes</h3>
                    <a href="#" class="text-decoration-none">Ver todos</a>
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Cliente</th>
                                <th>Empresa</th>
                                <th>Estado</th>
                                <th>Valor</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>María López</td>
                                <td>Soluciones SAS</td>
                                <td><span class="badge bg-success">Activo</span></td>
                                <td>$3,200</td>
                            </tr>
                            <tr>
                                <td>José García</td>
                                <td>NovaTech</td>
                                <td><span class="badge bg-warning text-dark">En revisión</span></td>
                                <td>$1,850</td>
                            </tr>
                            <tr>
                                <td>Laura Pérez</td>
                                <td>BlueWave</td>
                                <td><span class="badge bg-primary">Nuevo</span></td>
                                <td>$2,440</td>
                            </tr>
                            <tr>
                                <td>Carlos Vega</td>
                                <td>Grupo Vital</td>
                                <td><span class="badge bg-secondary">Inactivo</span></td>
                                <td>$980</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 py-3">
                    <h3 class="h5 mb-0">Tareas pendientes</h3>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <strong>Reunión con cliente</strong>
                            <div class="text-muted small">Hoy, 15:30</div>
                        </div>
                        <span class="badge bg-primary">Alta</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <strong>Enviar propuesta</strong>
                            <div class="text-muted small">Mañana</div>
                        </div>
                        <span class="badge bg-warning text-dark">Media</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <strong>Actualizar CRM</strong>
                            <div class="text-muted small">Viernes</div>
                        </div>
                        <span class="badge bg-success">Baja</span>
                    </div>

                    <button class="btn btn-outline-primary w-100 mt-2">Ver agenda</button>
                </div>
            </div>
        </div>
    </div>
</div>
