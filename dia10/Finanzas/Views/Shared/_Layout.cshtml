<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Finanzas</title>

    <script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@4"></script>
</head>
<body class="min-h-screen bg-slate-100 text-slate-800 antialiased">
    <header class="border-b border-slate-200 bg-white/85 shadow-sm backdrop-blur-sm">
        <nav class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="flex h-16 items-center justify-between">
                <a class="text-xl font-bold tracking-tight text-slate-900" asp-area="" asp-controller="Home" asp-action="Index">
                    Finanzas
                </a>

                <div class="flex items-center gap-5">
                    <a class="text-sm font-medium text-slate-600 transition hover:text-slate-900"
                        asp-area=""
                        asp-controller="Home"
                        asp-action="Index">
                        Home
                    </a>

                    <a class="text-sm font-medium text-slate-600 transition hover:text-slate-900"
                        asp-area=""
                        asp-controller="Home"
                        asp-action="Privacy">
                        Privacy
                    </a>

                    <a class="rounded-full bg-slate-900 px-4 py-2 text-sm font-medium text-white transition hover:bg-slate-700"
                        asp-area=""
                        asp-controller="Movimientos"
                        asp-action="Index">
                        Movimientos
                    </a>
                </div>
            </div>
        </nav>
    </header>

    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <main role="main" class="min-h-[calc(100vh-12rem)]">
            @RenderBody()
        </main>
    </div>

    <footer class="border-t border-slate-200 bg-white">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-6 text-sm text-slate-500 sm:px-6 lg:px-8">
            <span>&copy; 2026 - Finanzas</span>
            <a class="text-slate-600 transition hover:text-slate-900"
                asp-area=""
                asp-controller="Home"
                asp-action="Privacy">
                Privacy
            </a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>