@model Movimiento
@{
    ViewData["Title"] = "Eliminar Movimientos";
    
}

<div class="flex min-h-[60vh] items-center justify-center px-4 py-8">
    <div class="w-full max-w-xl rounded-3xl border border-red-200 bg-white p-6 shadow-sm sm:p-8">
        <div class="mb-6">
            <p class="text-xs font-semibold uppercase tracking-[0.25em] text-red-500">Confirmación</p>
            <h1 class="mt-2 text-3xl font-bold text-slate-900">Eliminar Movimiento</h1>
        </div>

        <p class="mb-6 text-base text-slate-600">¿Seguro que quiere eliminar el movimiento?</p>

        <dl class="space-y-4 rounded-2xl bg-slate-50 p-4">
            <div class="flex flex-col gap-1 border-b border-slate-200 pb-3 last:border-b-0 last:pb-0">
                <dt class="text-sm font-medium text-slate-500">Tipo</dt>
                <dd class="text-base font-semibold text-slate-800">@Model.TipoMovimiento</dd>
            </div>

            <div class="flex flex-col gap-1 border-b border-slate-200 pb-3 last:border-b-0 last:pb-0">
                <dt class="text-sm font-medium text-slate-500">Descripcion</dt>
                <dd class="text-base font-semibold text-slate-800">@Model.Descripcion</dd>
            </div>

            <div class="flex flex-col gap-1">
                <dt class="text-sm font-medium text-slate-500">Monto</dt>
                <dd class="text-base font-semibold text-slate-800">@Model.Monto.ToString("N0") Gs.</dd>
            </div>
        </dl>

        <form asp-action="DeleteConfirmed" method="post" class="mt-6">
            <input type="hidden" name="id" value="@Model.Id" />

            <div class="flex flex-col gap-3 sm:flex-row">
                <button type="submit" class="inline-flex flex-1 items-center justify-center rounded-xl bg-red-600 px-4 py-2.5 text-sm font-medium text-white shadow-sm transition hover:bg-red-500">
                    Sí, eliminar
                </button>
                <a asp-action="Index" class="inline-flex flex-1 items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50">
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>