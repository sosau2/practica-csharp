@model List<Pregunta>
@{
    ViewData["Title"]="Jugar";

}
<h1>Suerte, @ViewBag.Jugador</h1>

@if (Model.Count==0)
{
    <p> Todavia no hay preguntas cargadas. Agregalas e la seccion Preguntas</p>

}
else
{
    <form asp-action="Responder" method="post">
        <input type="hidden" name="jugador" value="@ViewBag.Jugador" />
        @for (int i = 0; i < Model.Count; i++)
        {
            Pregunta p = Model[i];
            <fieldset class="mb-4">
                <legend>@(i+1). @p.Texto</legend>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="respuestas[@p.Id]" id="r@(p.Id)" value="A" required />
                <label class="form-check-label" for="r@(p.Id)A">@p.OpcionA</label>
            </div>    
                        <div class="form-check">
                <input class="form-check-input" type="radio" name="respuestas[@p.Id]" id="r@(p.Id)" value="B" required />
                <label class="form-check-label" for="r@(p.Id)B">@p.OpcionB</label>
            </div>
                        <div class="form-check">
                <input class="form-check-input" type="radio" name="respuestas[@p.Id]" id="r@(p.Id)" value="C" required />
                <label class="form-check-label" for="r@(p.Id)C">@p.OpcionC</label>
            </div>
                        <div class="form-check">
                <input class="form-check-input" type="radio" name="respuestas[@p.Id]" id="r@(p.Id)" value="D" required />
                <label class="form-check-label" for="r@(p.Id)D">@p.OpcionD</label>
            </div>
            </fieldset>
        }
            <button type="submit" class="btn btn-success">Enviar</button>
        </form>
}